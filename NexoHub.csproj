<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <ApplicationIcon>Assets\Brand\NexoHub.ico</ApplicationIcon>
    <AssemblyName>NexoHub</AssemblyName>
    <Product>Nexo Device Hub</Product>
    <Version>0.3.12</Version>
    <Company>Nexo</Company>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="checks/**/*.cs" />
    <EmbeddedResource Include="Assets/ajazz-ak820pro-layout.json" />
    <Resource Include="Assets/Brand/NexoHub.ico" />
    <Resource Include="Assets/Brand/NexoHub.png" />
    <Resource Include="Assets/Devices/ajazz-ak820pro.png" />
    <Resource Include="Assets/Devices/astro-a50-gen3.png" />
  </ItemGroup>

</Project>
