                                    </Grid>
                                </TabItem>
                                <TabItem Header="Palanca derecha">
                                    <Grid Margin="26,18,18,14">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="330" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" MaxWidth="290" VerticalAlignment="Top">
                                            <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
