<Window x:Class="NexoHub.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:NexoHub"
        xmlns:converters="clr-namespace:NexoHub.Converters"
        xmlns:controls="clr-namespace:NexoHub.Controls"
        Title="Nexo · Device Hub" Height="820" Width="1360"
        Icon="Assets/Brand/NexoHub.ico"
        MinHeight="700" MinWidth="1080"
        WindowStartupLocation="CenterScreen"
        PreviewKeyDown="WindowPreviewKeyDown"
        Background="#1F1F1F" Foreground="#FFFFFF"
        FontFamily="Segoe UI Variable Text">
    <Window.Resources>
        <SolidColorBrush x:Key="Canvas" Color="#1F1F1F" />
        <SolidColorBrush x:Key="Panel" Color="#2D2D2D" />
        <SolidColorBrush x:Key="PanelRaised" Color="#383838" />
        <SolidColorBrush x:Key="Signal" Color="#0078D4" />
        <SolidColorBrush x:Key="XboxBlue" Color="#0078D4" />
        <Style x:Key="XboxFlatButton" TargetType="Button">
            <Setter Property="Background" Value="#303030" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="BorderBrush" Value="#414141" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="XboxButtonSurface" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="XboxButtonSurface" Property="Background" Value="#3A3A3A" /></Trigger>
                            <Trigger Property="IsEnabled" Value="False"><Setter TargetName="XboxButtonSurface" Property="Opacity" Value="0.45" /></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="XboxPrimaryButton" TargetType="Button" BasedOn="{StaticResource XboxFlatButton}">
            <Setter Property="Background" Value="{StaticResource XboxBlue}" />
            <Setter Property="BorderBrush" Value="{StaticResource XboxBlue}" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style x:Key="XboxTriggerHandleSlider" TargetType="Slider">
            <Setter Property="Height" Value="20" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Slider">
                        <Grid Background="Transparent">
                            <Track x:Name="PART_Track" Minimum="{TemplateBinding Minimum}" Maximum="{TemplateBinding Maximum}"
                                   Value="{TemplateBinding Value}" Orientation="Horizontal" IsDirectionReversed="{TemplateBinding IsDirectionReversed}">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="Slider.DecreaseLarge" Background="Transparent" BorderThickness="0" Focusable="False" IsTabStop="False" />
                                </Track.DecreaseRepeatButton>
                                <Track.Thumb><Thumb Width="5" Height="20" Background="White" BorderThickness="0" /></Track.Thumb>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="Slider.IncreaseLarge" Background="Transparent" BorderThickness="0" Focusable="False" IsTabStop="False" />
                                </Track.IncreaseRepeatButton>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="XboxBrightnessSliderStyle" TargetType="Slider">
            <Setter Property="Height" Value="26" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Slider">
                        <Grid>
                            <Border Height="12" CornerRadius="6" VerticalAlignment="Center">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0.5" EndPoint="1,0.5">
                                        <GradientStop Color="#111111" Offset="0" />
                                        <GradientStop Color="#FFFFFF" Offset="1" />
                                    </LinearGradientBrush>
                                </Border.Background>
                            </Border>
                            <Track x:Name="PART_Track" Minimum="{TemplateBinding Minimum}" Maximum="{TemplateBinding Maximum}"
                                   Value="{TemplateBinding Value}" Orientation="Horizontal" IsDirectionReversed="{TemplateBinding IsDirectionReversed}">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="Slider.DecreaseLarge" Background="Transparent" BorderThickness="0" Focusable="False" IsTabStop="False" />
                                </Track.DecreaseRepeatButton>
                                <Track.Thumb><Thumb Width="6" Height="24" Background="White" BorderThickness="0" /></Track.Thumb>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="Slider.IncreaseLarge" Background="Transparent" BorderThickness="0" Focusable="False" IsTabStop="False" />
                                </Track.IncreaseRepeatButton>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <SolidColorBrush x:Key="Calibration" Color="#0078D4" />
        <SolidColorBrush x:Key="TextMain" Color="#FFFFFF" />
        <SolidColorBrush x:Key="TextMuted" Color="#B3B3B3" />
        <SolidColorBrush x:Key="Line" Color="#4A4A4A" />
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
        <converters:InverseBooleanConverter x:Key="InverseBoolConverter" />
        <converters:InverseBooleanToVisibilityConverter x:Key="InverseBoolToVisibility" />

        <Style x:Key="NavOption" TargetType="RadioButton">
            <Setter Property="Foreground" Value="{StaticResource TextMuted}" />
            <Setter Property="FontSize" Value="15" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Padding" Value="14,12" />
            <Setter Property="Margin" Value="0,3" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="NavBorder" Background="Transparent" CornerRadius="10" Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="NavBorder" Property="Background" Value="#383838" />
                                <Setter Property="Foreground" Value="{StaticResource TextMain}" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="NavBorder" Property="Background" Value="#2A2A2A" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ActionButton" TargetType="Button">
            <Setter Property="Foreground" Value="#1F1F1F" />
            <Setter Property="Background" Value="{StaticResource Signal}" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Padding" Value="16,10" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder" Background="{TemplateBinding Background}" CornerRadius="9" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.88" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.4" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="QuietButton" TargetType="Button" BasedOn="{StaticResource ActionButton}">
            <Setter Property="Foreground" Value="{StaticResource TextMain}" />
            <Setter Property="Background" Value="{StaticResource PanelRaised}" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>

        <Style x:Key="DeviceCardButton" TargetType="Button">
            <Setter Property="Foreground" Value="{StaticResource TextMain}" />
            <Setter Property="Background" Value="{StaticResource Panel}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="CardSurface" Background="{TemplateBinding Background}" BorderBrush="{StaticResource Line}"
                                BorderThickness="1" CornerRadius="16" RenderTransformOrigin="0.5,0.5">
                            <Border.RenderTransform>
                                <ScaleTransform x:Name="CardScale" />
                            </Border.RenderTransform>
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="CardSurface" Property="BorderBrush" Value="{StaticResource Signal}" />
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="CardScale" Storyboard.TargetProperty="ScaleX" To="1.02" Duration="0:0:0.20">
                                                <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                            <DoubleAnimation Storyboard.TargetName="CardScale" Storyboard.TargetProperty="ScaleY" To="1.02" Duration="0:0:0.20">
                                                <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="CardScale" Storyboard.TargetProperty="ScaleX" To="1" Duration="0:0:0.18">
                                                <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                            <DoubleAnimation Storyboard.TargetName="CardScale" Storyboard.TargetProperty="ScaleY" To="1" Duration="0:0:0.18">
                                                <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="CardSurface" Property="BorderBrush" Value="{StaticResource Signal}" />
                                <Setter TargetName="CardSurface" Property="BorderThickness" Value="2" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="CardSurface" Property="Opacity" Value="0.5" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="LogitechDpiStageButton" TargetType="RadioButton">
            <Setter Property="Foreground" Value="{StaticResource TextMuted}" />
            <Setter Property="Padding" Value="9,8" />
            <Setter Property="Margin" Value="0,0,7,0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="StageSurface" Background="#222222" BorderBrush="#3A3A3A"
                                BorderThickness="1" CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="StageSurface" Property="Background" Value="#292B2D" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="StageSurface" Property="Background" Value="#3A3A3A" />
                                <Setter TargetName="StageSurface" Property="BorderBrush" Value="#0078D4" />
                                <Setter Property="Foreground" Value="#3A9DF4" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="StageSurface" Property="BorderThickness" Value="2" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ListBox">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Foreground" Value="{StaticResource TextMain}" />
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
        </Style>
        <Style TargetType="ListBoxItem">
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0,0,0,8" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="ItemBorder" Background="Transparent" CornerRadius="12" Padding="12">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="#383838" />
                                <Setter TargetName="ItemBorder" Property="BorderBrush" Value="{StaticResource Signal}" />
                                <Setter TargetName="ItemBorder" Property="BorderThickness" Value="1" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="#303030" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="#252525" />
            <Setter Property="Foreground" Value="{StaticResource TextMain}" />
            <Setter Property="BorderBrush" Value="{StaticResource Line}" />
            <Setter Property="CaretBrush" Value="{StaticResource Signal}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="8,6" />
            <Setter Property="SelectionBrush" Value="#666666" />
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="Background" Value="{StaticResource PanelRaised}" />
            <Setter Property="Foreground" Value="{StaticResource TextMain}" />
            <Setter Property="BorderBrush" Value="{StaticResource Line}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="7,5" />
            <Setter Property="MinHeight" Value="32" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid SnapsToDevicePixels="True">
                            <ToggleButton x:Name="DropDownToggle" Background="{TemplateBinding Background}"
                                          Foreground="{TemplateBinding Foreground}" BorderBrush="{TemplateBinding BorderBrush}"
                                          BorderThickness="{TemplateBinding BorderThickness}" Padding="{TemplateBinding Padding}"
                                          Focusable="False" ClickMode="Press"
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="22" />
                                    </Grid.ColumnDefinitions>
                                    <ContentPresenter Content="{TemplateBinding SelectionBoxItem}"
                                                      ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                                      ContentStringFormat="{TemplateBinding SelectionBoxItemStringFormat}"
                                                      VerticalAlignment="Center" Margin="2,0,4,0" />
                                    <TextBlock Grid.Column="1" Text="⌄" Foreground="{StaticResource TextMuted}"
                                               HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="12" />
                                </Grid>
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border x:Name="ToggleBorder" Background="{TemplateBinding Background}"
                                                BorderBrush="{TemplateBinding BorderBrush}"
                                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6"
                                                Padding="{TemplateBinding Padding}">
                                            <ContentPresenter />
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="ToggleBorder" Property="BorderBrush" Value="{StaticResource Signal}" />
                                            </Trigger>
                                            <Trigger Property="IsEnabled" Value="False">
                                                <Setter TargetName="ToggleBorder" Property="Opacity" Value="0.55" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            <Popup x:Name="Popup" Placement="Bottom" AllowsTransparency="True" Focusable="False"
                                   IsOpen="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}}"
                                   PlacementTarget="{Binding RelativeSource={RelativeSource TemplatedParent}}"
                                   PopupAnimation="Fade">
                                <Border Background="{StaticResource PanelRaised}" BorderBrush="{StaticResource Line}"
                                        BorderThickness="1" CornerRadius="6" MinWidth="{Binding PlacementTarget.ActualWidth, RelativeSource={RelativeSource AncestorType=Popup}}"
                                        MaxHeight="{TemplateBinding MaxDropDownHeight}" Margin="0,3,0,0">
                                    <ScrollViewer CanContentScroll="True">
                                        <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained" />
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="HasItems" Value="False">
                                <Setter TargetName="Popup" Property="MinHeight" Value="24" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground" Value="{StaticResource TextMuted}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="ComboBoxItem">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{StaticResource TextMain}" />
            <Setter Property="Padding" Value="8,6" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="ItemBorder" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="#444444" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="#4B4B4B" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground" Value="{StaticResource TextMuted}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid x:Name="NexoRootGrid" Margin="16">
        <Grid.ColumnDefinitions>
            <ColumnDefinition x:Name="NexoNavigationColumn" Width="226" />
            <ColumnDefinition x:Name="NexoNavigationGap" Width="24" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border x:Name="NexoNavigation" Grid.Column="0" Background="#252525" CornerRadius="18" Padding="18">
            <DockPanel LastChildFill="True">
                <StackPanel DockPanel.Dock="Top">
                    <StackPanel Orientation="Horizontal" Margin="4,5,0,32">
                        <Image Source="/Assets/Brand/NexoHub.png" Width="36" Height="36" Stretch="Uniform" VerticalAlignment="Center" />
                        <StackPanel Margin="11,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="Nexo" FontSize="21" FontWeight="Bold" Foreground="{StaticResource TextMain}" />
                            <TextBlock Text="DEVICE HUB" FontSize="9" FontWeight="Bold" Foreground="{StaticResource TextMuted}" />
                        </StackPanel>
                    </StackPanel>
                    <TextBlock Text="Tu espacio" Margin="12,0,0,8" FontSize="11" Foreground="{StaticResource TextMuted}" />
                    <RadioButton x:Name="DevicesNav" GroupName="Navigation" Tag="Devices" IsChecked="True" Checked="Navigate" Style="{StaticResource NavOption}" Content="Dispositivos" />
                    <RadioButton GroupName="Navigation" Tag="Profiles" Checked="Navigate" Style="{StaticResource NavOption}" Content="Perfiles" />
                    <RadioButton x:Name="MacrosNav" GroupName="Navigation" Tag="Macros" Checked="Navigate" Style="{StaticResource NavOption}" Content="Macros" />
                </StackPanel>

                <Border DockPanel.Dock="Bottom" Background="#2D2D2D" CornerRadius="12" Padding="13" Margin="0,20,0,0">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="8" Height="8" Fill="{StaticResource Signal}" VerticalAlignment="Center" />
                            <TextBlock Text="  Búsqueda activa" FontSize="12" FontWeight="SemiBold" />
                        </StackPanel>
                        <TextBlock Text="HID · XInput · audio Windows" Foreground="{StaticResource TextMuted}" FontSize="11" Margin="16,5,0,0" />
                    </StackPanel>
                </Border>
            </DockPanel>
        </Border>

        <Grid x:Name="NexoPages" Grid.Column="2">
            <Grid x:Name="DevicesPage">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition x:Name="DevicesPageHeaderGap" Height="18" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Grid x:Name="DevicesPageHeader" Grid.Row="0">
                    <StackPanel>
                        <TextBlock x:Name="DevicesPageTitle" Text="Tus dispositivos" FontSize="29" FontWeight="Bold" />
                        <TextBlock x:Name="DevicesPageSubtitle" Text="Una vista para el equipo que usas." Margin="0,5,0,0" Foreground="{StaticResource TextMuted}" FontSize="14" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <Button x:Name="BackToDevicesButton" Content="‹ Todos los dispositivos" Click="ShowDeviceCards"
                                Style="{StaticResource QuietButton}" Margin="0,0,12,0" Visibility="Collapsed" />
                        <TextBlock Text="●" Foreground="{StaticResource Signal}" VerticalAlignment="Center" FontSize="11" />
                        <TextBlock Text="  USB · Bluetooth · audio Windows" Foreground="{StaticResource TextMuted}" VerticalAlignment="Center" FontSize="12" Margin="0,0,14,0" />
                        <Button Content="Buscar ahora" Click="RefreshDevices" Style="{StaticResource QuietButton}" />
                    </StackPanel>
                </Grid>

                <Grid Grid.Row="2">
                    <Grid x:Name="DeviceCardsView">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="12" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Grid Margin="4,0,4,0">
                            <TextBlock Text="{Binding ScanStatus}" Foreground="{StaticResource TextMuted}" FontSize="12" VerticalAlignment="Center" />
                            <Button Content="{Binding AuxiliaryButtonLabel}" Click="ToggleAuxiliary" Style="{StaticResource QuietButton}"
                                    Padding="10,7" HorizontalAlignment="Right"
                                    Visibility="{Binding HasAuxiliaryDevices, Converter={StaticResource BoolToVisibility}}" />
                        </Grid>
                        <ScrollViewer x:Name="DeviceCardsScrollViewer" Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <Grid>
                                <ItemsControl ItemsSource="{Binding Devices}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Button Style="{StaticResource DeviceCardButton}" Click="OpenDeviceSettings" Tag="{Binding}"
                                                    Width="280" Height="360" Margin="0,0,16,16"
                                                    AutomationProperties.Name="{Binding DisplayName}"
                                                    AutomationProperties.HelpText="Abre los ajustes de este dispositivo.">
                                                <Grid Margin="18">
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="Auto" />
                                                        <RowDefinition Height="Auto" />
                                                        <RowDefinition Height="*" />
                                                        <RowDefinition Height="Auto" />
                                                        <RowDefinition Height="Auto" />
                                                    </Grid.RowDefinitions>
                                                    <TextBlock Text="{Binding DisplayName}" FontSize="19" FontWeight="Bold" TextWrapping="Wrap" />
                                                    <TextBlock Grid.Row="1" Text="{Binding Brand}" Foreground="{StaticResource Signal}" FontSize="10" FontWeight="Bold" Margin="0,4,0,0" />
                                                    <Border Grid.Row="2" Background="#252525" CornerRadius="12" Margin="0,12,0,8">
                                                        <Grid>
                                                            <Image Source="{Binding ProductImageSource}" Width="220" Height="190" Margin="12"
                                                                   Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality"
                                                                   Visibility="{Binding HasProductImage, Converter={StaticResource BoolToVisibility}}" />
                                                            <controls:DeviceIllustration Width="190" Height="165" Kind="{Binding VisualKind}"
                                                                                        Accent="{StaticResource Signal}" VerticalAlignment="Center"
                                                                                        Visibility="{Binding HasProductImage, Converter={StaticResource InverseBoolToVisibility}}" />
                                                        </Grid>
                                                    </Border>
                                                    <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,4,0,14">
                                                        <TextBlock Text="{Binding Status}" Foreground="{StaticResource TextMuted}" FontSize="11" VerticalAlignment="Center" />
                                                        <Border Background="#383838" CornerRadius="7" Padding="8,5" Margin="10,0,0,0">
                                                            <TextBlock Text="{Binding Transport}" FontSize="10" />
                                                        </Border>
                                                    </StackPanel>
                                                    <Grid Grid.Row="4">
                                                        <TextBlock Text="Ajustes disponibles" Foreground="{StaticResource TextMuted}" FontSize="10" VerticalAlignment="Center" />
                                                        <TextBlock Text="Configurar  →" Foreground="{StaticResource Signal}" FontSize="11" FontWeight="SemiBold" HorizontalAlignment="Right" />
                                                    </Grid>
                                                </Grid>
                                            </Button>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="300"
                                            Visibility="{Binding HasNoDevices, Converter={StaticResource BoolToVisibility}}">
                                    <TextBlock Text="Conecta un dispositivo para empezar" FontSize="19" FontWeight="Bold" TextAlignment="Center" TextWrapping="Wrap" />
                                    <TextBlock Text="Nexo detectará lo que conectes y mostrará los ajustes disponibles." Foreground="{StaticResource TextMuted}"
                                               TextAlignment="Center" TextWrapping="Wrap" Margin="0,9,0,0" />
                                </StackPanel>
                            </Grid>
                        </ScrollViewer>
                    </Grid>

                    <Grid x:Name="DeviceSettingsView" Visibility="Collapsed" Opacity="1">
                    <Border Background="{StaticResource Panel}" CornerRadius="16" Padding="24"
                            Visibility="{Binding SelectedDevice.IsXboxElite, Converter={StaticResource InverseBoolToVisibility}}">
                        <Grid>
                          <Grid Visibility="{Binding HasSelectedDevice, Converter={StaticResource BoolToVisibility}}">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="12" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="12" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <Grid Grid.Row="0" MinHeight="120">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="190" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Image Grid.Column="0" Source="{Binding SelectedDevice.ProductImageSource}" Width="174" Height="112"
                                       Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality"
                                       Visibility="{Binding SelectedDevice.HasProductImage, Converter={StaticResource BoolToVisibility}}" />
                                <controls:DeviceIllustration Grid.Column="0" Width="174" Height="112" Kind="{Binding SelectedDevice.VisualKind}"
                                                             Accent="{StaticResource Signal}"
                                                             Visibility="{Binding SelectedDevice.HasProductImage, Converter={StaticResource InverseBoolToVisibility}}" />
                                <StackPanel Grid.Column="1" Margin="18,2,0,0" VerticalAlignment="Center" MaxWidth="610">
                                    <TextBlock Text="{Binding SelectedDevice.Brand}" Foreground="{StaticResource Signal}" FontSize="10" FontWeight="Bold"
                                               Visibility="{Binding SelectedDevice.HasLogitechMouseSettings, Converter={StaticResource InverseBoolToVisibility}}" />
                                    <TextBlock Text="{Binding SelectedDevice.DisplayName}" FontSize="26" FontWeight="Bold" Margin="0,3,0,0" />
                                    <TextBlock Text="{Binding SelectedDevice.Description}" Foreground="{StaticResource TextMuted}" FontSize="12" Margin="0,6,100,0" TextWrapping="Wrap"
                                               Visibility="{Binding SelectedDevice.HasLogitechMouseSettings, Converter={StaticResource InverseBoolToVisibility}}" />
                                    <StackPanel Orientation="Horizontal" Margin="0,10,0,0"
                                                Visibility="{Binding SelectedDevice.IsMouse, Converter={StaticResource InverseBoolToVisibility}}">
                                        <Border Background="#383838" CornerRadius="8" Padding="9,6" Margin="0,0,7,0">
                                            <TextBlock Text="{Binding SelectedDevice.HardwareId}" FontFamily="Segoe UI Mono" FontSize="10" />
                                        </Border>
                                        <Border Background="#383838" CornerRadius="8" Padding="9,6">
                                            <TextBlock Text="{Binding SelectedDevice.Transport}" FontSize="10" />
                                        </Border>
                                    </StackPanel>
                                </StackPanel>
                                <Border HorizontalAlignment="Right" VerticalAlignment="Top" Background="#3A3A3A" CornerRadius="12" Padding="10,6">
                                    <TextBlock Text="{Binding SelectedDevice.Status}" Foreground="{StaticResource Signal}" FontSize="10" FontWeight="SemiBold" />
                                </Border>
                            </Grid>

                            <TextBlock Grid.Row="2" Text="{Binding SelectedDevice.InterfaceSummary}" Foreground="{StaticResource TextMuted}" FontSize="11" VerticalAlignment="Center"
                                       Visibility="{Binding SelectedDevice.IsMouse, Converter={StaticResource InverseBoolToVisibility}}" />

                            <ScrollViewer Grid.Row="4" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                <StackPanel>
                                    <Border Background="#2A2A2A" CornerRadius="13" Padding="16" Margin="0,0,0,12">
                                        <StackPanel>
                                            <TextBlock Text="{Binding SelectedDevice.SettingsTitle}" FontSize="17" FontWeight="Bold"
                                                       Visibility="{Binding SelectedDevice.ShowGenericSettingsHeader, Converter={StaticResource BoolToVisibility}}" />
                                            <TextBlock Text="{Binding SelectedDevice.SettingsSummary}" Foreground="{StaticResource TextMuted}" FontSize="12" TextWrapping="Wrap" Margin="0,5,0,12"
                                                       Visibility="{Binding SelectedDevice.ShowGenericSettingsHeader, Converter={StaticResource BoolToVisibility}}" />
                                            <Border Background="#252525" BorderBrush="#353535" BorderThickness="1" CornerRadius="12" Padding="14" Margin="0,0,0,9"
                                                    Visibility="{Binding SelectedDevice.HasLogitechMouseSettings, Converter={StaticResource BoolToVisibility}}">
                                                <Border.Triggers>
                                                    <EventTrigger RoutedEvent="MouseEnter">
                                                        <BeginStoryboard>
                                                            <Storyboard>
                                                                <DoubleAnimation Storyboard.TargetName="LogitechAccent" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.16" />
                                                            </Storyboard>
                                                        </BeginStoryboard>
                                                    </EventTrigger>
                                                    <EventTrigger RoutedEvent="MouseLeave">
                                                        <BeginStoryboard>
                                                            <Storyboard>
                                                                <DoubleAnimation Storyboard.TargetName="LogitechAccent" Storyboard.TargetProperty="Opacity" To="0.55" Duration="0:0:0.16" />
                                                            </Storyboard>
                                                        </BeginStoryboard>
                                                    </EventTrigger>
                                                </Border.Triggers>
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="3" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>
                                                    <Border x:Name="LogitechAccent" Background="#0078D4" CornerRadius="2" Opacity="0.55" Margin="0,2,0,2" />
                                                    <StackPanel Grid.Column="1" Margin="13,0,0,0">
                                                        <Grid>
                                                            <StackPanel>
                                                                <TextBlock Text="DPI" FontSize="19" FontWeight="SemiBold" />
                                                            </StackPanel>
                                                        </Grid>
                                                        <TextBlock Text="Modelo por confirmar. El perfil está listo y podrás aplicar los DPI cuando se reconozca."
                                                                   Foreground="{StaticResource Calibration}" FontSize="10" TextWrapping="Wrap" Margin="0,0,0,8"
                                                                   Visibility="{Binding SelectedDevice.IsUnidentifiedLogitechMouse, Converter={StaticResource BoolToVisibility}}" />
                                                        <UniformGrid Columns="5">
                                                            <RadioButton GroupName="LogitechDpiStages" IsChecked="{Binding SelectedDevice.IsLogitechDpiStage1Selected, Mode=TwoWay}" Style="{StaticResource LogitechDpiStageButton}" AutomationProperties.Name="Seleccionar etapa DPI 1">
                                                                <StackPanel><TextBlock Text="NIVEL 1" FontSize="9" /><TextBlock Text="{Binding SelectedDevice.LogitechDpiStage1Value, StringFormat={}{0:N0}}" FontFamily="Segoe UI Mono" FontSize="15" FontWeight="SemiBold" Margin="0,4,0,0" /><TextBlock Text="DPI" FontSize="8" Foreground="{StaticResource TextMuted}" /></StackPanel>
                                                            </RadioButton>
                                                            <RadioButton GroupName="LogitechDpiStages" IsChecked="{Binding SelectedDevice.IsLogitechDpiStage2Selected, Mode=TwoWay}" Style="{StaticResource LogitechDpiStageButton}" Visibility="{Binding SelectedDevice.HasLogitechDpiStage2, Converter={StaticResource BoolToVisibility}}" AutomationProperties.Name="Seleccionar etapa DPI 2">
                                                                <StackPanel><TextBlock Text="NIVEL 2" FontSize="9" /><TextBlock Text="{Binding SelectedDevice.LogitechDpiStage2Value, StringFormat={}{0:N0}}" FontFamily="Segoe UI Mono" FontSize="15" FontWeight="SemiBold" Margin="0,4,0,0" /><TextBlock Text="DPI" FontSize="8" Foreground="{StaticResource TextMuted}" /></StackPanel>
                                                            </RadioButton>
                                                            <RadioButton GroupName="LogitechDpiStages" IsChecked="{Binding SelectedDevice.IsLogitechDpiStage3Selected, Mode=TwoWay}" Style="{StaticResource LogitechDpiStageButton}" Visibility="{Binding SelectedDevice.HasLogitechDpiStage3, Converter={StaticResource BoolToVisibility}}" AutomationProperties.Name="Seleccionar etapa DPI 3">
                                                                <StackPanel><TextBlock Text="NIVEL 3" FontSize="9" /><TextBlock Text="{Binding SelectedDevice.LogitechDpiStage3Value, StringFormat={}{0:N0}}" FontFamily="Segoe UI Mono" FontSize="15" FontWeight="SemiBold" Margin="0,4,0,0" /><TextBlock Text="DPI" FontSize="8" Foreground="{StaticResource TextMuted}" /></StackPanel>
                                                            </RadioButton>
                                                            <RadioButton GroupName="LogitechDpiStages" IsChecked="{Binding SelectedDevice.IsLogitechDpiStage4Selected, Mode=TwoWay}" Style="{StaticResource LogitechDpiStageButton}" Visibility="{Binding SelectedDevice.HasLogitechDpiStage4, Converter={StaticResource BoolToVisibility}}" AutomationProperties.Name="Seleccionar etapa DPI 4">
                                                                <StackPanel><TextBlock Text="NIVEL 4" FontSize="9" /><TextBlock Text="{Binding SelectedDevice.LogitechDpiStage4Value, StringFormat={}{0:N0}}" FontFamily="Segoe UI Mono" FontSize="15" FontWeight="SemiBold" Margin="0,4,0,0" /><TextBlock Text="DPI" FontSize="8" Foreground="{StaticResource TextMuted}" /></StackPanel>
                                                            </RadioButton>
                                                            <RadioButton GroupName="LogitechDpiStages" IsChecked="{Binding SelectedDevice.IsLogitechDpiStage5Selected, Mode=TwoWay}" Style="{StaticResource LogitechDpiStageButton}" Visibility="{Binding SelectedDevice.HasLogitechDpiStage5, Converter={StaticResource BoolToVisibility}}" Margin="0" AutomationProperties.Name="Seleccionar etapa DPI 5">
                                                                <StackPanel><TextBlock Text="NIVEL 5" FontSize="9" /><TextBlock Text="{Binding SelectedDevice.LogitechDpiStage5Value, StringFormat={}{0:N0}}" FontFamily="Segoe UI Mono" FontSize="15" FontWeight="SemiBold" Margin="0,4,0,0" /><TextBlock Text="DPI" FontSize="8" Foreground="{StaticResource TextMuted}" /></StackPanel>
                                                            </RadioButton>
                                                        </UniformGrid>
                                                        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                                            <Button Content="Añadir nivel" Click="AddLogitechDpiStage" IsEnabled="{Binding SelectedDevice.CanAddLogitechDpiStage}" Style="{StaticResource QuietButton}" Padding="10,6" AutomationProperties.Name="Añadir nivel DPI" />
                                                            <Button Content="Quitar nivel" Click="RemoveLogitechDpiStage" IsEnabled="{Binding SelectedDevice.CanRemoveLogitechDpiStage}" Style="{StaticResource QuietButton}" Padding="10,6" Margin="8,0,0,0" AutomationProperties.Name="Quitar nivel DPI" />
                                                        </StackPanel>
                                                        <Grid Margin="0,14,0,0">
                                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                                                <TextBlock Text="{Binding SelectedDevice.SelectedLogitechDpiValue, StringFormat={}{0:N0}}" FontFamily="Segoe UI Mono" FontSize="22" FontWeight="Bold" Foreground="#0078D4" />
                                                                <TextBlock Text="DPI" FontSize="10" Foreground="{StaticResource TextMuted}" VerticalAlignment="Bottom" Margin="6,0,0,3" />
                                                            </StackPanel>
                                                        </Grid>
                                                        <Slider Minimum="100" Maximum="25600" SmallChange="50" LargeChange="1000" TickFrequency="1000"
                                                                IsSnapToTickEnabled="False" Value="{Binding SelectedDevice.SelectedLogitechDpiValue, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                                Foreground="#0078D4" Margin="0,2,0,0" AutomationProperties.Name="DPI de la etapa activa"
                                                                AutomationProperties.HelpText="Modifica únicamente el perfil local de Nexo." />
                                                        <Grid Margin="0,-2,0,9">
                                                            <TextBlock Text="100 DPI" FontSize="9" Foreground="{StaticResource TextMuted}" />
                                                            <TextBlock Text="25.600 DPI" FontSize="9" Foreground="{StaticResource TextMuted}" HorizontalAlignment="Right" />
                                                        </Grid>
                                                        <StackPanel Orientation="Horizontal" Margin="0,10,0,0" Visibility="{Binding SelectedDevice.IsLogitechDpiWritable, Converter={StaticResource BoolToVisibility}}">
                                                            <Button Content="Aplicar al ratón" Click="ApplyLogitechDpi" IsEnabled="{Binding CanApplyLogitechDpi}" Style="{StaticResource ActionButton}" Padding="11,7" />
                                                        </StackPanel>
                                                        <TextBlock Text="{Binding SelectedDevice.LogitechProfileStorageStatus}" Foreground="{StaticResource TextMuted}" FontSize="10" Margin="0,6,0,0" />
                                                            <Button Content="Guardar niveles en el ratón" Click="SaveLogitechOnboardDpi"
                                                                IsEnabled="{Binding DataContext.CanSaveLogitechOnboardDpi, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                Visibility="{Binding SelectedDevice.CanSaveLogitechOnboardDpi, Converter={StaticResource BoolToVisibility}}"
                                                                Style="{StaticResource ActionButton}" Padding="11,7" Margin="0,8,0,0"
                                                                AutomationProperties.HelpText="Guarda los niveles en el ratón y aplica el nivel activo." />
                                                    </StackPanel>
                                                </Grid>
                                            </Border>
                                            <Border Background="#2A2A2A" CornerRadius="10" Padding="12" Margin="0,0,0,9"
                                                    Visibility="{Binding SelectedDevice.IsUnidentifiedLogitechMouse, Converter={StaticResource BoolToVisibility}}">
                                                <Grid>
                                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                                    <StackPanel>
                                                        <TextBlock Text="No se pudo reconocer este ratón" Foreground="#0078D4" FontSize="11" FontWeight="Bold" />
                                                        <TextBlock Text="Puedes preparar el perfil y volver a intentarlo." Foreground="{StaticResource TextMuted}" FontSize="10" TextWrapping="Wrap" Margin="0,3,12,0" />
                                                    </StackPanel>
                                                    <Button Grid.Column="1" Content="Reintentar" Click="ReadLogitechMouseIdentity" IsEnabled="{Binding CanIdentifyLogitech}" Style="{StaticResource QuietButton}" Padding="10,7" VerticalAlignment="Center" />
                                                </Grid>
                                            </Border>
                                            <Border Background="#252525" CornerRadius="10" Padding="12" Margin="0,0,0,9"
                                                    Visibility="{Binding SelectedDevice.IsAjazzKeyboard, Converter={StaticResource BoolToVisibility}}">
                                                <StackPanel>
                                                    <TextBlock Text="AJAZZ AK820 · perfil local de Nexo" Foreground="{StaticResource Signal}" FontSize="10" FontWeight="Bold" />
                                                    <TextBlock Text="El controlador AJAZZ declara AK820 por USB (8009/800A) o receptor 2.4 GHz (FDFD); Bluetooth no está soportado. Ningún valor de esta pantalla se envía al firmware." Foreground="{StaticResource TextMuted}" FontSize="10" TextWrapping="Wrap" Margin="0,3,0,9" />
                                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                        <TextBlock Text="Efecto local" FontSize="11" VerticalAlignment="Center" />
                                                        <ComboBox ItemsSource="{Binding LightingEffects}" SelectedItem="{Binding SelectedDevice.LocalProfile.LightingEffect}" Width="145" Margin="8,0,16,0" />
                                                        <TextBlock Text="Color RGB" FontSize="11" VerticalAlignment="Center" />
                                                        <TextBox Text="{Binding SelectedDevice.LocalProfile.LightingColor, UpdateSourceTrigger=PropertyChanged}" Width="85" Margin="8,0,0,0" />
                                                    </StackPanel>
                                                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0" VerticalAlignment="Center">
                                                        <TextBlock Text="Brillo" FontSize="11" />
                                                        <Slider Minimum="0" Maximum="100" Value="{Binding SelectedDevice.LocalProfile.LightingBrightness}" Width="220" Margin="10,0" />
                                                        <TextBlock Text="{Binding SelectedDevice.LocalProfile.LightingBrightness, StringFormat={}{0}%}" FontSize="11" />
                                                    </StackPanel>
                                                    <TextBlock Text="MAPA REAL DEL CONTROLADOR · 81 TECLAS" Foreground="{StaticResource TextMuted}" FontSize="9" FontWeight="Bold" Margin="0,13,0,5" />
                                                    <Border Background="#262626" CornerRadius="8" Padding="5" Height="190">
                                                        <controls:AjazzKeyboardMap x:Name="AjazzKeyboardMap" KeyColors="{Binding SelectedDevice.LocalProfile.KeyboardKeyColors}" />
                                                    </Border>
                                                    <TextBlock Margin="0,6,0,0" FontSize="10" Foreground="{StaticResource TextMuted}">
                                                        <Run Text="Tecla seleccionada: " />
                                                        <Run Text="{Binding SelectedKeyName, ElementName=AjazzKeyboardMap}" Foreground="{StaticResource TextMain}" FontWeight="SemiBold" />
                                                        <Run Text=" · código HID " />
                                                        <Run Text="{Binding SelectedKeyCode, ElementName=AjazzKeyboardMap}" Foreground="{StaticResource TextMain}" />
                                                    </TextBlock>
                                                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                                        <Button Content="Asignar color a tecla" Click="AssignAjazzKeyColor" Style="{StaticResource QuietButton}" Padding="10,7" />
                                                        <Button Content="Quitar color personalizado" Click="ClearAjazzKeyColor" Style="{StaticResource QuietButton}" Padding="10,7" Margin="8,0,0,0" />
                                                    </StackPanel>
                                                    <TextBlock Text="Selecciona una tecla y asígnale el color RGB de arriba. Pulsa Guardar perfil Nexo para conservar los cambios en este PC." Foreground="{StaticResource TextMuted}" FontSize="10" TextWrapping="Wrap" Margin="0,6,0,0" />
                                                </StackPanel>
                                            </Border>
                                            <Border Background="#252525" CornerRadius="10" Padding="12" Margin="0,0,0,9"
                                                    Visibility="{Binding SelectedDevice.IsXboxElite, Converter={StaticResource BoolToVisibility}}">
                                                <Grid>
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="Auto" />
                                                        <RowDefinition Height="8" />
                                                        <RowDefinition Height="Auto" />
                                                        <RowDefinition Height="8" />
                                                        <RowDefinition Height="Auto" />
                                                        <RowDefinition Height="8" />
                                                        <RowDefinition Height="Auto" />
                                                    </Grid.RowDefinitions>
                                                    <Grid>
                                                        <StackPanel>
                                                            <TextBlock Text="Mando Xbox Elite" Foreground="{StaticResource Signal}" FontSize="16" FontWeight="Bold" />
                                                            <TextBlock Text="Solo LB → Menú se envía por GIP. La ranura y su persistencia no están verificadas; el resto del perfil es local." Foreground="{StaticResource TextMuted}" FontSize="11" Margin="0,3,0,0" />
                                                        </StackPanel>
                                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                                            <ComboBox ItemsSource="{Binding SelectedDevice.LocalProfiles}" SelectedItem="{Binding SelectedDevice.LocalProfile, Mode=TwoWay}"
                                                                      DisplayMemberPath="Name" Width="210" AutomationProperties.Name="Perfil del mando" />
                                                            <Button Content="Nuevo" Click="AddDeviceLocalProfile" IsEnabled="{Binding SelectedDevice.CanAddLocalProfile}"
                                                                    Style="{StaticResource QuietButton}" Margin="7,0,0,0" Padding="10,7" />
                                                            <Button Content="Quitar" Click="RemoveDeviceLocalProfile" IsEnabled="{Binding SelectedDevice.CanDeleteLocalProfile}"
                                                                    Style="{StaticResource QuietButton}" Margin="7,0,0,0" Padding="10,7" />
                                                        </StackPanel>
                                                    </Grid>
                                                    <Grid Grid.Row="2">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>
                                                        <Expander Header="Cambiar perfil según el juego" Foreground="{StaticResource TextMuted}" VerticalAlignment="Center">
                                                            <StackPanel Margin="0,7,0,0">
                                                                <TextBox Text="{Binding SelectedDevice.LocalProfile.ApplicationExecutable, UpdateSourceTrigger=PropertyChanged}"
                                                                         VerticalContentAlignment="Center" ToolTip="Ejecutable asociado a este perfil" />
                                                                <StackPanel Orientation="Horizontal" Margin="0,7,0,0">
                                                                    <Button Content="Elegir juego" Click="LinkDeviceProfileApplication" Style="{StaticResource QuietButton}" Padding="10,7" />
                                                                    <Button Content="Quitar" Click="UnlinkDeviceProfileApplication" Style="{StaticResource QuietButton}" Margin="8,0,0,0" Padding="10,7" />
                                                                </StackPanel>
                                                                <TextBlock Text="Este perfil local se activa al abrir el juego elegido." Foreground="{StaticResource TextMuted}" FontSize="10" Margin="0,5,0,0" />
                                                            </StackPanel>
                                                        </Expander>
                                                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,0">
                                                            <TextBox Text="{Binding SelectedDevice.LocalProfile.Name, UpdateSourceTrigger=PropertyChanged}" Width="170"
                                                                     VerticalContentAlignment="Center" ToolTip="Nombre del perfil guardado por Nexo" />
                                                            <Button Content="Guardar en este PC" Click="SaveDeviceProfile" Style="{StaticResource ActionButton}"
                                                                    Margin="8,0,0,0" Padding="12,8" />
                                                        </StackPanel>
                                                    </Grid>
                                                    <TabControl Grid.Row="4" Background="Transparent" BorderThickness="0" MinHeight="330">
                                                        <TabControl.Resources>
                                                            <Style TargetType="TabItem">
                                                                <Setter Property="Foreground" Value="{StaticResource TextMuted}" />
                                                                <Setter Property="Background" Value="Transparent" />
                                                                <Setter Property="Padding" Value="12,9" />
                                                                <Setter Property="Margin" Value="0,0,5,0" />
                                                                <Setter Property="Template">
                                                                    <Setter.Value>
                                                                        <ControlTemplate TargetType="TabItem">
                                                                            <Border x:Name="TabSurface" Background="{TemplateBinding Background}" BorderBrush="Transparent"
                                                                                    BorderThickness="0,0,0,2" CornerRadius="7,7,0,0" Padding="{TemplateBinding Padding}">
                                                                                <ContentPresenter ContentSource="Header" HorizontalAlignment="Center" />
                                                                            </Border>
                                                                            <ControlTemplate.Triggers>
                                                                                <Trigger Property="IsSelected" Value="True">
                                                                                    <Setter TargetName="TabSurface" Property="Background" Value="#383838" />
                                                                                    <Setter TargetName="TabSurface" Property="BorderBrush" Value="{StaticResource Signal}" />
                                                                                    <Setter Property="Foreground" Value="{StaticResource Signal}" />
                                                                                </Trigger>
                                                                                <Trigger Property="IsMouseOver" Value="True">
                                                                                    <Setter TargetName="TabSurface" Property="Background" Value="#2A2A2A" />
                                                                                </Trigger>
                                                                            </ControlTemplate.Triggers>
                                                                        </ControlTemplate>
                                                                    </Setter.Value>
                                                                </Setter>
                                                            </Style>
                                                        </TabControl.Resources>
                                                        <TabItem Header="Macros">
                                                            <Grid>
                                                                <Grid.ColumnDefinitions><ColumnDefinition Width="360" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                                                <Border Background="#383838" CornerRadius="0,8,8,8" Padding="14" Margin="0,0,14,0">
                                                                    <StackPanel>
                                                                        <TextBlock Text="Macros para este mando" FontSize="14" FontWeight="SemiBold" />
                                                                        <TextBlock Text="Elige en Macros el botón o gesto que inicia cada acción." Foreground="{StaticResource TextMuted}" FontSize="11" TextWrapping="Wrap" Margin="0,4,0,9" />
                                                                        <Button Content="Configurar macros" Click="OpenXboxMacros" Style="{StaticResource ActionButton}" Padding="11,7" HorizontalAlignment="Left" />
                                                                        <Border Background="#2D2D2D" CornerRadius="8" Padding="10" Margin="0,13,0,0">
                                                                            <StackPanel>
                                                                                <TextBlock Text="Botones pulsados" Foreground="{StaticResource Signal}" FontSize="10" FontWeight="Bold" Margin="0,0,0,5" />
                                                                                <TextBlock Text="{Binding SelectedDevice.XboxInput.ButtonsLabel}" FontSize="11" TextWrapping="Wrap" />
                                                                            </StackPanel>
                                                                        </Border>
                                                                        <TextBlock Text="Las macros funcionan mientras Nexo está abierto; el mando conserva sus botones originales." Foreground="{StaticResource TextMuted}" FontSize="10" TextWrapping="Wrap" Margin="0,9,0,0" />
                                                                    </StackPanel>
                                                                </Border>
                                                            </Grid>
                                                        </TabItem>
                                                        <TabItem Header="Palanca izquierda">
                                                            <Grid>
                                                                <Grid.ColumnDefinitions><ColumnDefinition Width="360" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                                                <Border Background="#383838" CornerRadius="0,8,8,8" Padding="14" Margin="0,0,14,0">
                                                                    <StackPanel>
                                                                        <TextBlock Text="Activar una macro al moverla" FontSize="13" FontWeight="SemiBold" />
                                                                        <TextBlock Text="Umbral de movimiento" Foreground="{StaticResource TextMuted}" FontSize="11" Margin="0,10,0,0" />
                                                                        <Slider Minimum="10" Maximum="90" TickFrequency="5" IsSnapToTickEnabled="True" Value="{Binding SelectedDevice.LocalProfile.LeftStickMacroThresholdPercent}" Margin="0,5,0,0" />
                                                                        <TextBlock Text="{Binding SelectedDevice.LocalProfile.LeftStickMacroThresholdPercent, StringFormat={}{0:0}%}" Foreground="{StaticResource Signal}" FontSize="13" FontWeight="SemiBold" />
                                                                        <Border Background="#2D2D2D" CornerRadius="8" Padding="10" Margin="0,13,0,0">
                                                                            <StackPanel><TextBlock Text="Lectura del stick" Foreground="{StaticResource TextMuted}" FontSize="10" /><TextBlock Text="{Binding SelectedDevice.XboxInput.LeftStickLabel}" FontSize="12" Margin="0,4,0,0" /></StackPanel>
                                                                        </Border>
                                                                        <TextBlock Text="Un umbral más alto exige mover más la palanca para iniciar el gesto." Foreground="{StaticResource TextMuted}" FontSize="10" TextWrapping="Wrap" Margin="0,9,0,0" />
                                                                    </StackPanel>
                                                                </Border>
                                                            </Grid>
                                                        </TabItem>
                                                        <TabItem Header="Palanca derecha">
                                                            <Grid>
                                                                <Grid.ColumnDefinitions><ColumnDefinition Width="360" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                                                <Border Background="#383838" CornerRadius="0,8,8,8" Padding="14" Margin="0,0,14,0">
                                                                    <StackPanel>
                                                                        <TextBlock Text="Activar una macro al moverla" FontSize="13" FontWeight="SemiBold" />
                                                                        <TextBlock Text="Umbral de movimiento" Foreground="{StaticResource TextMuted}" FontSize="11" Margin="0,10,0,0" />
                                                                        <Slider Minimum="10" Maximum="90" TickFrequency="5" IsSnapToTickEnabled="True" Value="{Binding SelectedDevice.LocalProfile.RightStickMacroThresholdPercent}" Margin="0,5,0,0" />
                                                                        <TextBlock Text="{Binding SelectedDevice.LocalProfile.RightStickMacroThresholdPercent, StringFormat={}{0:0}%}" Foreground="{StaticResource Signal}" FontSize="13" FontWeight="SemiBold" />
                                                                        <Border Background="#2D2D2D" CornerRadius="8" Padding="10" Margin="0,13,0,0">
                                                                            <StackPanel><TextBlock Text="Lectura del stick" Foreground="{StaticResource TextMuted}" FontSize="10" /><TextBlock Text="{Binding SelectedDevice.XboxInput.RightStickLabel}" FontSize="12" Margin="0,4,0,0" /></StackPanel>
                                                                        </Border>
                                                                        <TextBlock Text="Un umbral más alto exige mover más la palanca para iniciar el gesto." Foreground="{StaticResource TextMuted}" FontSize="10" TextWrapping="Wrap" Margin="0,9,0,0" />
                                                                    </StackPanel>
                                                                </Border>
                                                            </Grid>
                                                        </TabItem>
                                                        <TabItem Header="Gatillos">
                                                            <Grid>
                                                                <Grid.ColumnDefinitions><ColumnDefinition Width="360" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                                                <Border Background="#383838" CornerRadius="0,8,8,8" Padding="14" Margin="0,0,14,0">
