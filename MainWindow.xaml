                                                    <Line X1="86.4" Y1="0" X2="86.4" Y2="158" Stroke="#343434" /><Line X1="115.2" Y1="0" X2="115.2" Y2="158" Stroke="#343434" />
                                                    <Line X1="144" Y1="0" X2="144" Y2="158" Stroke="#343434" /><Line X1="172.8" Y1="0" X2="172.8" Y2="158" Stroke="#343434" />
                                                    <Line X1="201.6" Y1="0" X2="201.6" Y2="158" Stroke="#343434" /><Line X1="230.4" Y1="0" X2="230.4" Y2="158" Stroke="#343434" />
                                                    <Line X1="259.2" Y1="0" X2="259.2" Y2="158" Stroke="#343434" />
                                                    <Line X1="0" Y1="15.8" X2="288" Y2="15.8" Stroke="#343434" /><Line X1="0" Y1="31.6" X2="288" Y2="31.6" Stroke="#343434" />
                                                    <Line X1="0" Y1="47.4" X2="288" Y2="47.4" Stroke="#343434" /><Line X1="0" Y1="63.2" X2="288" Y2="63.2" Stroke="#343434" />
                                                    <Line X1="0" Y1="79" X2="288" Y2="79" Stroke="#343434" /><Line X1="0" Y1="94.8" X2="288" Y2="94.8" Stroke="#343434" />
                                                    <Line X1="0" Y1="110.6" X2="288" Y2="110.6" Stroke="#343434" /><Line X1="0" Y1="126.4" X2="288" Y2="126.4" Stroke="#343434" />
                                                    <Line X1="0" Y1="142.2" X2="288" Y2="142.2" Stroke="#343434" />
                                                    <Polyline x:Name="XboxRightStickCurveLine" Points="0,158 72,120 72,72 288,0" Stroke="{StaticResource XboxBlue}" StrokeThickness="3" />
                                                </Canvas>
                                            </Border>
                                            <CheckBox Content="Usar cálculo radial" Style="{StaticResource XboxEditorCheckBox}"
                                                      IsChecked="{Binding SelectedDevice.LocalProfile.XboxRightStickRadialCalculation}"
                                                      Margin="0,10,0,0" />
                                        </StackPanel>
                                        <Viewbox Grid.Column="1" Stretch="Uniform" MaxWidth="760" MaxHeight="560" HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <Grid Width="1080" Height="1080">
                                                <Image Source="{Binding SelectedDevice.XboxRightStickImageSource}" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality" />
                                                <Canvas Width="1080" Height="1080" IsHitTestVisible="False">
                                                    <Ellipse Canvas.Left="150" Canvas.Top="150" Width="780" Height="780" Stroke="#E6E6E6" StrokeThickness="2" />
                                                    <Ellipse Canvas.Left="210" Canvas.Top="210" Width="660" Height="660" Stroke="#858585" StrokeThickness="2" />
                                                    <Ellipse Canvas.Left="270" Canvas.Top="270" Width="540" Height="540" Stroke="#555555" StrokeThickness="2" />
                                                    <Canvas Width="1080" Height="1080" IsHitTestVisible="False">
                                                        <Canvas.RenderTransform>
                                                            <TranslateTransform X="{Binding SelectedDevice.XboxInput.RightStickPreviewX}"
                                                                                Y="{Binding SelectedDevice.XboxInput.RightStickPreviewY}" />
                                                        </Canvas.RenderTransform>
                                                        <Ellipse Canvas.Left="516" Canvas.Top="516" Width="48" Height="48" Stroke="{StaticResource XboxBlue}" StrokeThickness="3" />
                                                        <Line X1="540" Y1="510" X2="540" Y2="570" Stroke="{StaticResource XboxBlue}" StrokeThickness="2" />
                                                        <Line X1="510" Y1="540" X2="570" Y2="540" Stroke="{StaticResource XboxBlue}" StrokeThickness="2" />
                                                    </Canvas>
                                                </Canvas>
                                            </Grid>
                                        </Viewbox>
                                    </Grid>
                                </TabItem>
                                <TabItem Header="Gatillos">
                                    <Grid Margin="26,18,18,14">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="360" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" MaxWidth="340">
                                            <TextBlock Text="Mueve los controles deslizantes para ajustar las zonas muertas, luego aprieta el gatillo para probarlo." FontSize="13" TextWrapping="Wrap" Margin="0,15,0,20" />
                                            <Border Background="#303030" CornerRadius="4" Padding="14" Margin="0,0,0,12">
                                                <StackPanel>
                                                    <TextBlock Text="Gatillo izquierdo" FontSize="14" FontWeight="SemiBold" />
                                                    <Grid Height="74" Margin="0,8,0,0">
                                                        <Grid.RowDefinitions><RowDefinition Height="20" /><RowDefinition Height="34" /><RowDefinition Height="20" /></Grid.RowDefinitions>
