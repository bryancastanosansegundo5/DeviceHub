<Window x:Class="NexoHub.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:NexoHub"
        xmlns:converters="clr-namespace:NexoHub.Converters"
        xmlns:controls="clr-namespace:NexoHub.Controls"
        Title="Nexo · Device Hub" Height="820" Width="1360"
        MinHeight="700" MinWidth="1080"
        WindowStartupLocation="CenterScreen"
        Background="#111A20" Foreground="#E5EDF0"
        FontFamily="Segoe UI Variable Text">
    <Window.Resources>
        <SolidColorBrush x:Key="Canvas" Color="#111A20" />
        <SolidColorBrush x:Key="Panel" Color="#1D2931" />
        <SolidColorBrush x:Key="PanelRaised" Color="#24343D" />
        <SolidColorBrush x:Key="Signal" Color="#53D6C2" />
        <SolidColorBrush x:Key="Calibration" Color="#F0A35E" />
        <SolidColorBrush x:Key="TextMain" Color="#E5EDF0" />
        <SolidColorBrush x:Key="TextMuted" Color="#93A5AC" />
        <SolidColorBrush x:Key="Line" Color="#31434D" />
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
        <converters:InverseBooleanConverter x:Key="InverseBoolConverter" />
        <converters:InverseBooleanToVisibilityConverter x:Key="InverseBoolToVisibility" />

        <Style x:Key="NavOption" TargetType="RadioButton">
            <Setter Property="Foreground" Value="{StaticResource TextMuted}" />
            <Setter Property="FontSize" Value="15" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Padding" Value="14,12" />
            <Setter Property="Margin" Value="0,3" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="NavBorder" Background="Transparent" CornerRadius="10" Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="NavBorder" Property="Background" Value="#24343D" />
                                <Setter Property="Foreground" Value="{StaticResource TextMain}" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="NavBorder" Property="Background" Value="#202E36" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ActionButton" TargetType="Button">
            <Setter Property="Foreground" Value="#111A20" />
            <Setter Property="Background" Value="{StaticResource Signal}" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Padding" Value="16,10" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder" Background="{TemplateBinding Background}" CornerRadius="9" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.88" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.4" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="QuietButton" TargetType="Button" BasedOn="{StaticResource ActionButton}">
            <Setter Property="Foreground" Value="{StaticResource TextMain}" />
            <Setter Property="Background" Value="{StaticResource PanelRaised}" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>

        <Style x:Key="LogitechDpiStageButton" TargetType="RadioButton">
            <Setter Property="Foreground" Value="{StaticResource TextMuted}" />
            <Setter Property="Padding" Value="9,8" />
            <Setter Property="Margin" Value="0,0,7,0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="StageSurface" Background="#202326" BorderBrush="#393B3D"
                                BorderThickness="1" CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="StageSurface" Property="Background" Value="#292B2D" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="StageSurface" Property="Background" Value="#29260F" />
                                <Setter TargetName="StageSurface" Property="BorderBrush" Value="#F5C400" />
                                <Setter Property="Foreground" Value="#F5D84C" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="StageSurface" Property="BorderThickness" Value="2" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ListBox">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Foreground" Value="{StaticResource TextMain}" />
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
        </Style>
        <Style TargetType="ListBoxItem">
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0,0,0,8" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="ItemBorder" Background="Transparent" CornerRadius="12" Padding="12">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="#2A3A43" />
                                <Setter TargetName="ItemBorder" Property="BorderBrush" Value="{StaticResource Signal}" />
                                <Setter TargetName="ItemBorder" Property="BorderThickness" Value="1" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="#25343C" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="#172229" />
            <Setter Property="Foreground" Value="{StaticResource TextMain}" />
            <Setter Property="BorderBrush" Value="{StaticResource Line}" />
            <Setter Property="CaretBrush" Value="{StaticResource Signal}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="8,6" />
            <Setter Property="SelectionBrush" Value="#536D76" />
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="Background" Value="{StaticResource PanelRaised}" />
            <Setter Property="Foreground" Value="{StaticResource TextMain}" />
            <Setter Property="BorderBrush" Value="{StaticResource Line}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="7,5" />
            <Setter Property="MinHeight" Value="32" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid SnapsToDevicePixels="True">
                            <ToggleButton x:Name="DropDownToggle" Background="{TemplateBinding Background}"
                                          Foreground="{TemplateBinding Foreground}" BorderBrush="{TemplateBinding BorderBrush}"
                                          BorderThickness="{TemplateBinding BorderThickness}" Padding="{TemplateBinding Padding}"
                                          Focusable="False" ClickMode="Press"
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="22" />
                                    </Grid.ColumnDefinitions>
                                    <ContentPresenter Content="{TemplateBinding SelectionBoxItem}"
                                                      ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                                      ContentStringFormat="{TemplateBinding SelectionBoxItemStringFormat}"
                                                      VerticalAlignment="Center" Margin="2,0,4,0" />
                                    <TextBlock Grid.Column="1" Text="⌄" Foreground="{StaticResource TextMuted}"
                                               HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="12" />
                                </Grid>
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border x:Name="ToggleBorder" Background="{TemplateBinding Background}"
                                                BorderBrush="{TemplateBinding BorderBrush}"
                                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6"
                                                Padding="{TemplateBinding Padding}">
                                            <ContentPresenter />
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="ToggleBorder" Property="BorderBrush" Value="{StaticResource Signal}" />
                                            </Trigger>
                                            <Trigger Property="IsEnabled" Value="False">
                                                <Setter TargetName="ToggleBorder" Property="Opacity" Value="0.55" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            <Popup x:Name="Popup" Placement="Bottom" AllowsTransparency="True" Focusable="False"
                                   IsOpen="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}}"
                                   PlacementTarget="{Binding RelativeSource={RelativeSource TemplatedParent}}"
                                   PopupAnimation="Fade">
                                <Border Background="{StaticResource PanelRaised}" BorderBrush="{StaticResource Line}"
                                        BorderThickness="1" CornerRadius="6" MinWidth="{Binding PlacementTarget.ActualWidth, RelativeSource={RelativeSource AncestorType=Popup}}"
                                        MaxHeight="{TemplateBinding MaxDropDownHeight}" Margin="0,3,0,0">
                                    <ScrollViewer CanContentScroll="True">
                                        <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained" />
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="HasItems" Value="False">
                                <Setter TargetName="Popup" Property="MinHeight" Value="24" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground" Value="{StaticResource TextMuted}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="ComboBoxItem">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{StaticResource TextMain}" />
            <Setter Property="Padding" Value="8,6" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="ItemBorder" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="#30464F" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="#34524F" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground" Value="{StaticResource TextMuted}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="16">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="226" />
            <ColumnDefinition Width="24" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Background="#172229" CornerRadius="18" Padding="18">
            <DockPanel LastChildFill="True">
                <StackPanel DockPanel.Dock="Top">
                    <StackPanel Orientation="Horizontal" Margin="4,5,0,32">
                        <Border Width="34" Height="34" CornerRadius="10" Background="{StaticResource Signal}" VerticalAlignment="Center">
                            <TextBlock Text="N" Foreground="#111A20" FontWeight="Black" FontSize="19" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <StackPanel Margin="11,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="Nexo" FontSize="21" FontWeight="Bold" Foreground="{StaticResource TextMain}" />
                            <TextBlock Text="DEVICE HUB" FontSize="9" FontWeight="Bold" Foreground="{StaticResource TextMuted}" />
                        </StackPanel>
                    </StackPanel>
                    <TextBlock Text="Tu espacio" Margin="12,0,0,8" FontSize="11" Foreground="{StaticResource TextMuted}" />
                    <RadioButton x:Name="DevicesNav" GroupName="Navigation" Tag="Devices" IsChecked="True" Checked="Navigate" Style="{StaticResource NavOption}" Content="Dispositivos" />
                    <RadioButton GroupName="Navigation" Tag="Profiles" Checked="Navigate" Style="{StaticResource NavOption}" Content="Perfiles" />
                    <RadioButton GroupName="Navigation" Tag="Macros" Checked="Navigate" Style="{StaticResource NavOption}" Content="Macros" />
                </StackPanel>

                <Border DockPanel.Dock="Bottom" Background="#1D2931" CornerRadius="12" Padding="13" Margin="0,20,0,0">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="8" Height="8" Fill="{StaticResource Signal}" VerticalAlignment="Center" />
                            <TextBlock Text="  Búsqueda activa" FontSize="12" FontWeight="SemiBold" />
                        </StackPanel>
                        <TextBlock Text="HID · XInput · audio Windows" Foreground="{StaticResource TextMuted}" FontSize="11" Margin="16,5,0,0" />
                    </StackPanel>
                </Border>
            </DockPanel>
        </Border>

        <Grid Grid.Column="2">
            <Grid x:Name="DevicesPage">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="18" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Grid Grid.Row="0">
                    <StackPanel>
                        <TextBlock Text="Tus dispositivos" FontSize="29" FontWeight="Bold" />
                        <TextBlock Text="Una vista para el equipo que usas." Margin="0,5,0,0" Foreground="{StaticResource TextMuted}" FontSize="14" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <TextBlock Text="●" Foreground="{StaticResource Signal}" VerticalAlignment="Center" FontSize="11" />
                        <TextBlock Text="  USB · Bluetooth · audio Windows" Foreground="{StaticResource TextMuted}" VerticalAlignment="Center" FontSize="12" Margin="0,0,14,0" />
                        <Button Content="Buscar ahora" Click="RefreshDevices" Style="{StaticResource QuietButton}" />
                    </StackPanel>
                </Grid>

                <Grid Grid.Row="2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="300" />
                        <ColumnDefinition Width="18" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Background="{StaticResource Panel}" CornerRadius="16" Padding="14">
                        <DockPanel>
                            <StackPanel DockPanel.Dock="Top" Margin="4,3,4,12">
                                <TextBlock Text="Conectados" FontSize="15" FontWeight="Bold" />
                                <TextBlock Text="{Binding ScanStatus}" FontSize="11" Foreground="{StaticResource TextMuted}" Margin="0,5,0,0" TextWrapping="Wrap" />
                                <Button Content="{Binding AuxiliaryButtonLabel}" Click="ToggleAuxiliary" Style="{StaticResource QuietButton}"
                                        Margin="0,10,0,0" HorizontalAlignment="Left" Padding="10,7"
                                        Visibility="{Binding HasAuxiliaryDevices, Converter={StaticResource BoolToVisibility}}" />
                            </StackPanel>
                            <Grid>
                                <ListBox ItemsSource="{Binding Devices}" SelectedItem="{Binding SelectedDevice, Mode=TwoWay}">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="92" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <controls:DeviceIllustration Width="82" Height="58" Kind="{Binding VisualKind}" Accent="{StaticResource Signal}" />
                                                <StackPanel Grid.Column="1" Margin="10,2,0,0" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" TextWrapping="Wrap" />
                                                    <TextBlock Text="{Binding Brand}" Foreground="{StaticResource Signal}" FontSize="9" FontWeight="Bold" Margin="0,3,0,0" />
                                                    <TextBlock Text="{Binding HardwareId}" Foreground="{StaticResource TextMuted}" FontSize="10" Margin="0,3,0,0" />
                                                    <TextBlock Text="{Binding LogitechConnectionStatus}" Foreground="{StaticResource TextMuted}" FontSize="9" Margin="0,3,0,0"
                                                               Visibility="{Binding IsLogitechHidppCandidate, Converter={StaticResource BoolToVisibility}}"
                                                               ToolTip="Activo significa que el ratón respondió. Si no responde, puede estar en reposo, apagado o fuera de alcance." />
                                                </StackPanel>
                                            </Grid>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="215"
                                            Visibility="{Binding HasNoDevices, Converter={StaticResource BoolToVisibility}}">
                                    <TextBlock Text="Aún no aparece ningún dispositivo" TextAlignment="Center" FontWeight="SemiBold" TextWrapping="Wrap" />
                                    <TextBlock Text="Conecta un equipo por USB o Bluetooth. Nexo lo buscará automáticamente." TextAlignment="Center" Foreground="{StaticResource TextMuted}" FontSize="12" Margin="0,8,0,0" TextWrapping="Wrap" />
                                </StackPanel>
                            </Grid>
                        </DockPanel>
                    </Border>

                    <Border Grid.Column="2" Background="{StaticResource Panel}" CornerRadius="16" Padding="20">
                        <Grid>
                          <Grid Visibility="{Binding HasSelectedDevice, Converter={StaticResource BoolToVisibility}}">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="12" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="12" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <Grid Grid.Row="0" MinHeight="120">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="190" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <controls:DeviceIllustration Grid.Column="0" Width="174" Height="112" Kind="{Binding SelectedDevice.VisualKind}" Accent="{StaticResource Signal}" />
                                <StackPanel Grid.Column="1" Margin="18,2,0,0" VerticalAlignment="Center" MaxWidth="610">
                                    <TextBlock Text="{Binding SelectedDevice.Brand}" Foreground="{StaticResource Signal}" FontSize="10" FontWeight="Bold" />
                                    <TextBlock Text="{Binding SelectedDevice.DisplayName}" FontSize="26" FontWeight="Bold" Margin="0,3,0,0" />
                                    <TextBlock Text="{Binding SelectedDevice.Description}" Foreground="{StaticResource TextMuted}" FontSize="12" Margin="0,6,100,0" TextWrapping="Wrap" />
                                    <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                        <Border Background="#24343D" CornerRadius="8" Padding="9,6" Margin="0,0,7,0">
                                            <TextBlock Text="{Binding SelectedDevice.HardwareId}" FontFamily="Segoe UI Mono" FontSize="10" />
                                        </Border>
                                        <Border Background="#24343D" CornerRadius="8" Padding="9,6">
                                            <TextBlock Text="{Binding SelectedDevice.Transport}" FontSize="10" />
                                        </Border>
                                    </StackPanel>
                                </StackPanel>
                                <Border HorizontalAlignment="Right" VerticalAlignment="Top" Background="#23433F" CornerRadius="12" Padding="10,6">
                                    <TextBlock Text="{Binding SelectedDevice.Status}" Foreground="{StaticResource Signal}" FontSize="10" FontWeight="SemiBold" />
                                </Border>
                            </Grid>

                            <TextBlock Grid.Row="2" Text="{Binding SelectedDevice.InterfaceSummary}" Foreground="{StaticResource TextMuted}" FontSize="11" VerticalAlignment="Center" />

                            <ScrollViewer Grid.Row="4" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                <StackPanel>
                                    <Border Background="#202E36" CornerRadius="13" Padding="16" Margin="0,0,0,12">
                                        <StackPanel>
                                            <TextBlock Text="{Binding SelectedDevice.SettingsTitle}" FontSize="17" FontWeight="Bold" />
                                            <TextBlock Text="{Binding SelectedDevice.SettingsSummary}" Foreground="{StaticResource TextMuted}" FontSize="12" TextWrapping="Wrap" Margin="0,5,0,12" />
                                            <Border Background="#17191B" BorderBrush="#35383A" BorderThickness="1" CornerRadius="12" Padding="14" Margin="0,0,0,9"
                                                    Visibility="{Binding SelectedDevice.IsLogitechMouse, Converter={StaticResource BoolToVisibility}}">
                                                <Border.Triggers>
                                                    <EventTrigger RoutedEvent="MouseEnter">
                                                        <BeginStoryboard>
                                                            <Storyboard>
                                                                <DoubleAnimation Storyboard.TargetName="LogitechAccent" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.16" />
                                                            </Storyboard>
                                                        </BeginStoryboard>
                                                    </EventTrigger>
                                                    <EventTrigger RoutedEvent="MouseLeave">
                                                        <BeginStoryboard>
                                                            <Storyboard>
                                                                <DoubleAnimation Storyboard.TargetName="LogitechAccent" Storyboard.TargetProperty="Opacity" To="0.55" Duration="0:0:0.16" />
                                                            </Storyboard>
                                                        </BeginStoryboard>
                                                    </EventTrigger>
                                                </Border.Triggers>
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="3" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>
                                                    <Border x:Name="LogitechAccent" Background="#F5C400" CornerRadius="2" Opacity="0.55" Margin="0,2,0,2" />
                                                    <StackPanel Grid.Column="1" Margin="13,0,0,0">
                                                        <Grid>
                                                            <StackPanel>
                                                                <TextBlock Text="{Binding SelectedDevice.LogitechProfileTitle}" Foreground="#F5C400" FontSize="10" FontWeight="Bold" />
                                                                <TextBlock Text="Sensibilidad (DPI)" FontSize="19" FontWeight="SemiBold" Margin="0,3,0,0" />
                                                            </StackPanel>
                                                            <Border HorizontalAlignment="Right" VerticalAlignment="Top" Background="#29260F" CornerRadius="8" Padding="8,5">
                                                                <TextBlock Text="PERFIL NEXO" Foreground="#F5D84C" FontSize="9" FontWeight="Bold" />
                                                            </Border>
                                                        </Grid>
                                                        <TextBlock Text="{Binding SelectedDevice.LogitechDpiRange}" Foreground="{StaticResource TextMuted}" FontSize="10" Margin="0,3,0,10" />
                                                        <UniformGrid Columns="5">
                                                            <RadioButton GroupName="LogitechDpiStages" IsChecked="{Binding SelectedDevice.IsLogitechDpiStage1Selected, Mode=TwoWay}" Style="{StaticResource LogitechDpiStageButton}" AutomationProperties.Name="Seleccionar etapa DPI 1">
                                                                <StackPanel><TextBlock Text="ETAPA 01" FontSize="9" /><TextBlock Text="{Binding SelectedDevice.LogitechDpiStage1Value, StringFormat={}{0:N0}}" FontFamily="Segoe UI Mono" FontSize="15" FontWeight="SemiBold" Margin="0,4,0,0" /><TextBlock Text="DPI" FontSize="8" Foreground="{StaticResource TextMuted}" /></StackPanel>
                                                            </RadioButton>
                                                            <RadioButton GroupName="LogitechDpiStages" IsChecked="{Binding SelectedDevice.IsLogitechDpiStage2Selected, Mode=TwoWay}" Style="{StaticResource LogitechDpiStageButton}" Visibility="{Binding SelectedDevice.HasLogitechDpiStage2, Converter={StaticResource BoolToVisibility}}" AutomationProperties.Name="Seleccionar etapa DPI 2">
                                                                <StackPanel><TextBlock Text="ETAPA 02" FontSize="9" /><TextBlock Text="{Binding SelectedDevice.LogitechDpiStage2Value, StringFormat={}{0:N0}}" FontFamily="Segoe UI Mono" FontSize="15" FontWeight="SemiBold" Margin="0,4,0,0" /><TextBlock Text="DPI" FontSize="8" Foreground="{StaticResource TextMuted}" /></StackPanel>
                                                            </RadioButton>
                                                            <RadioButton GroupName="LogitechDpiStages" IsChecked="{Binding SelectedDevice.IsLogitechDpiStage3Selected, Mode=TwoWay}" Style="{StaticResource LogitechDpiStageButton}" Visibility="{Binding SelectedDevice.HasLogitechDpiStage3, Converter={StaticResource BoolToVisibility}}" AutomationProperties.Name="Seleccionar etapa DPI 3">
                                                                <StackPanel><TextBlock Text="ETAPA 03" FontSize="9" /><TextBlock Text="{Binding SelectedDevice.LogitechDpiStage3Value, StringFormat={}{0:N0}}" FontFamily="Segoe UI Mono" FontSize="15" FontWeight="SemiBold" Margin="0,4,0,0" /><TextBlock Text="DPI" FontSize="8" Foreground="{StaticResource TextMuted}" /></StackPanel>
                                                            </RadioButton>
                                                            <RadioButton GroupName="LogitechDpiStages" IsChecked="{Binding SelectedDevice.IsLogitechDpiStage4Selected, Mode=TwoWay}" Style="{StaticResource LogitechDpiStageButton}" Visibility="{Binding SelectedDevice.HasLogitechDpiStage4, Converter={StaticResource BoolToVisibility}}" AutomationProperties.Name="Seleccionar etapa DPI 4">
                                                                <StackPanel><TextBlock Text="ETAPA 04" FontSize="9" /><TextBlock Text="{Binding SelectedDevice.LogitechDpiStage4Value, StringFormat={}{0:N0}}" FontFamily="Segoe UI Mono" FontSize="15" FontWeight="SemiBold" Margin="0,4,0,0" /><TextBlock Text="DPI" FontSize="8" Foreground="{StaticResource TextMuted}" /></StackPanel>
                                                            </RadioButton>
                                                            <RadioButton GroupName="LogitechDpiStages" IsChecked="{Binding SelectedDevice.IsLogitechDpiStage5Selected, Mode=TwoWay}" Style="{StaticResource LogitechDpiStageButton}" Visibility="{Binding SelectedDevice.HasLogitechDpiStage5, Converter={StaticResource BoolToVisibility}}" Margin="0" AutomationProperties.Name="Seleccionar etapa DPI 5">
                                                                <StackPanel><TextBlock Text="ETAPA 05" FontSize="9" /><TextBlock Text="{Binding SelectedDevice.LogitechDpiStage5Value, StringFormat={}{0:N0}}" FontFamily="Segoe UI Mono" FontSize="15" FontWeight="SemiBold" Margin="0,4,0,0" /><TextBlock Text="DPI" FontSize="8" Foreground="{StaticResource TextMuted}" /></StackPanel>
                                                            </RadioButton>
                                                        </UniformGrid>
                                                        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
