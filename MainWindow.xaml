                                                        <Border Height="4" Background="{StaticResource XboxBlue}" VerticalAlignment="Center" />
                                                        <UniformGrid Columns="11" IsHitTestVisible="False">
                                                            <Border Width="1" Height="12" Background="#909090" /><Border Width="1" Height="12" Background="#909090" /><Border Width="1" Height="12" Background="#909090" />
                                                            <Border Width="1" Height="12" Background="#909090" /><Border Width="1" Height="12" Background="#909090" /><Border Width="1" Height="12" Background="#909090" />
                                                            <Border Width="1" Height="12" Background="#909090" /><Border Width="1" Height="12" Background="#909090" /><Border Width="1" Height="12" Background="#909090" />
                                                            <Border Width="1" Height="12" Background="#909090" /><Border Width="1" Height="12" Background="#909090" />
                                                        </UniformGrid>
                                                        <Slider x:Name="LeftTriggerStartSlider" Minimum="0" Maximum="100" TickFrequency="10" Value="{Binding SelectedDevice.LocalProfile.XboxLeftTriggerDeadzoneStart, Mode=TwoWay}"
                                                                Style="{StaticResource XboxTriggerHandleSlider}" VerticalAlignment="Top" AutomationProperties.Name="Inicio del gatillo izquierdo" />
                                                        <Slider x:Name="LeftTriggerEndSlider" Minimum="0" Maximum="100" TickFrequency="10" Value="{Binding SelectedDevice.LocalProfile.XboxLeftTriggerDeadzoneEnd, Mode=TwoWay}"
                                                                Style="{StaticResource XboxTriggerHandleSlider}" VerticalAlignment="Bottom" AutomationProperties.Name="Final del gatillo izquierdo" />
                                                        </Grid>
                                                        <TextBlock Grid.Row="2" Margin="12,0,0,0" Text="{Binding Value, ElementName=LeftTriggerEndSlider, StringFormat={}{0:0}}" />
                                                    </Grid>
                                                </StackPanel>
                                            </Border>
                                            <Border Background="#303030" CornerRadius="4" Padding="14">
                                                <StackPanel>
                                                    <TextBlock Text="Gatillo derecho" FontSize="14" FontWeight="SemiBold" />
                                                    <Grid Height="74" Margin="0,8,0,0">
                                                        <Grid.RowDefinitions><RowDefinition Height="20" /><RowDefinition Height="34" /><RowDefinition Height="20" /></Grid.RowDefinitions>
                                                        <TextBlock Grid.Row="0" Text="{Binding Value, ElementName=RightTriggerStartSlider, StringFormat={}{0:0}}" />
                                                        <Grid Grid.Row="1" Height="34">
                                                        <Border Height="4" Background="{StaticResource XboxBlue}" VerticalAlignment="Center" />
                                                        <UniformGrid Columns="11" IsHitTestVisible="False">
                                                            <Border Width="1" Height="12" Background="#909090" /><Border Width="1" Height="12" Background="#909090" /><Border Width="1" Height="12" Background="#909090" />
                                                            <Border Width="1" Height="12" Background="#909090" /><Border Width="1" Height="12" Background="#909090" /><Border Width="1" Height="12" Background="#909090" />
                                                            <Border Width="1" Height="12" Background="#909090" /><Border Width="1" Height="12" Background="#909090" /><Border Width="1" Height="12" Background="#909090" />
                                                            <Border Width="1" Height="12" Background="#909090" /><Border Width="1" Height="12" Background="#909090" />
                                                        </UniformGrid>
                                                        <Slider x:Name="RightTriggerStartSlider" Minimum="0" Maximum="100" TickFrequency="10" Value="{Binding SelectedDevice.LocalProfile.XboxRightTriggerDeadzoneStart, Mode=TwoWay}"
                                                                Style="{StaticResource XboxTriggerHandleSlider}" VerticalAlignment="Top" AutomationProperties.Name="Inicio del gatillo derecho" />
                                                        <Slider x:Name="RightTriggerEndSlider" Minimum="0" Maximum="100" TickFrequency="10" Value="{Binding SelectedDevice.LocalProfile.XboxRightTriggerDeadzoneEnd, Mode=TwoWay}"
                                                                Style="{StaticResource XboxTriggerHandleSlider}" VerticalAlignment="Bottom" AutomationProperties.Name="Final del gatillo derecho" />
                                                        </Grid>
                                                        <TextBlock Grid.Row="2" Margin="12,0,0,0" Text="{Binding Value, ElementName=RightTriggerEndSlider, StringFormat={}{0:0}}" />
                                                    </Grid>
                                                </StackPanel>
                                            </Border>
                                            <CheckBox Content="Reflejar gatillo" Style="{StaticResource XboxEditorCheckBox}"
                                                      IsChecked="{Binding SelectedDevice.LocalProfile.XboxMirrorTriggers}" Margin="0,12,0,0" />
                                        </StackPanel>
                                        <Viewbox Grid.Column="1" Stretch="Uniform" MaxWidth="760" MaxHeight="560" HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <Grid Width="1080" Height="1080">
                                                <Image Source="{Binding SelectedDevice.XboxLeftTriggerImageSource}" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality" />
                                                <Canvas Width="1080" Height="1080" IsHitTestVisible="False">
                                                    <Path Data="M 390,160 A 300,300 0 0 0 390,760" Stroke="#A0A0A0" StrokeThickness="15" StrokeDashArray="0.05,1.1" StrokeDashCap="Round" />
                                                </Canvas>
                                            </Grid>
                                        </Viewbox>
                                    </Grid>
                                </TabItem>
                                <TabItem Header="Vibración">
                                    <Grid Margin="26,18,18,14">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="360" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" MaxWidth="340">
                                            <TextBlock Text="Mueve los controles deslizantes para ajustar y sentir la intensidad de la vibración." FontSize="13" TextWrapping="Wrap" Margin="0,15,0,18" />
                                            <Border Background="#303030" CornerRadius="4" Padding="12" Margin="0,0,0,8">
                                                <StackPanel><TextBlock Text="Gatillo izquierdo" /><Slider x:Name="XboxLeftTriggerVibrationSlider" Minimum="0" Maximum="100" TickFrequency="10" TickPlacement="BottomRight" Value="{Binding SelectedDevice.LocalProfile.XboxLeftTriggerVibration, Mode=TwoWay}" Foreground="{StaticResource XboxBlue}" /></StackPanel>
                                            </Border>
                                            <Border Background="#303030" CornerRadius="4" Padding="12" Margin="0,0,0,8">
                                                <StackPanel><TextBlock Text="Vibración izquierda principal" /><Slider x:Name="XboxLeftMainVibrationSlider" Minimum="0" Maximum="100" TickFrequency="10" TickPlacement="BottomRight" Value="{Binding SelectedDevice.LocalProfile.XboxLeftMainVibration, Mode=TwoWay}" Foreground="{StaticResource XboxBlue}" /></StackPanel>
                                            </Border>
                                            <Border Background="#303030" CornerRadius="4" Padding="12" Margin="0,0,0,8">
                                                <StackPanel><TextBlock Text="Gatillo derecho" /><Slider x:Name="XboxRightTriggerVibrationSlider" Minimum="0" Maximum="100" TickFrequency="10" TickPlacement="BottomRight" Value="{Binding SelectedDevice.LocalProfile.XboxRightTriggerVibration, Mode=TwoWay}" Foreground="{StaticResource XboxBlue}" /></StackPanel>
                                            </Border>
                                            <Border Background="#303030" CornerRadius="4" Padding="12">
                                                <StackPanel><TextBlock Text="Vibración derecha principal" /><Slider x:Name="XboxRightMainVibrationSlider" Minimum="0" Maximum="100" TickFrequency="10" TickPlacement="BottomRight" Value="{Binding SelectedDevice.LocalProfile.XboxRightMainVibration, Mode=TwoWay}" Foreground="{StaticResource XboxBlue}" /></StackPanel>
                                            </Border>
                                        </StackPanel>
                                        <Viewbox Grid.Column="1" Stretch="Uniform" MaxWidth="740" MaxHeight="520" HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <Grid Width="680" Height="480">
                                                <Image Source="{Binding SelectedDevice.XboxBackImageSource}" Stretch="Fill" RenderOptions.BitmapScalingMode="HighQuality" />
                                                <Canvas Width="680" Height="480" IsHitTestVisible="False">
                                                    <Ellipse Canvas.Left="74" Canvas.Top="4" Width="104" Height="104" Stroke="#D0D0D0" StrokeThickness="5" Opacity="0.7" />
                                                    <Ellipse Canvas.Left="502" Canvas.Top="4" Width="104" Height="104" Stroke="#D0D0D0" StrokeThickness="5" Opacity="0.7" />
                                                    <Ellipse Canvas.Left="22" Canvas.Top="346" Width="120" Height="120" Stroke="#D0D0D0" StrokeThickness="5" Opacity="0.7" />
                                                    <Ellipse Canvas.Left="538" Canvas.Top="346" Width="120" Height="120" Stroke="#D0D0D0" StrokeThickness="5" Opacity="0.7" />
                                                </Canvas>
                                            </Grid>
                                        </Viewbox>
                                    </Grid>
                                </TabItem>
                                <TabItem Header="Brillo">
                                    <Grid Margin="26,18,18,14">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="430" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" MaxWidth="420" VerticalAlignment="Top">
                                            <TextBlock Text="Ajusta el brillo del botón Xbox para este perfil. El cambio se guarda como copia local en Nexo." FontSize="13" TextWrapping="Wrap" Margin="0,20,0,25" />
                                            <Border Background="#303030" CornerRadius="4" Padding="14">
                                                <StackPanel>
                                                    <TextBlock Text="Brillo" FontSize="13" />
                                                    <Slider x:Name="XboxBrightnessSlider" Minimum="0" Maximum="100" Value="{Binding SelectedDevice.LocalProfile.XboxButtonBrightness, Mode=TwoWay}"
                                                            Style="{StaticResource XboxBrightnessSliderStyle}" Margin="0,12,0,0" AutomationProperties.Name="Brillo del botón Xbox" />
                                                </StackPanel>
                                            </Border>
                                        </StackPanel>
                                        <Image Grid.Column="1" Source="{Binding SelectedDevice.XboxBrightnessImageSource}" MaxWidth="600" MaxHeight="550"
                                               Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center" RenderOptions.BitmapScalingMode="HighQuality" />
                                    </Grid>
                                </TabItem>
                            </TabControl>
                            </Grid>
                        </Grid>
                    </Border>
                    </Grid>
                </Grid>
            </Grid>

            <Grid x:Name="ProfilesPage" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="18" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Grid>
                    <StackPanel>
                        <TextBlock Text="Perfiles" FontSize="29" FontWeight="Bold" />
                        <TextBlock Text="Guarda y organiza perfiles de tus dispositivos." Margin="0,5,0,0" Foreground="{StaticResource TextMuted}" FontSize="14" />
                        <TextBlock Text="{Binding ProfileStatus}" Margin="0,4,0,0" Foreground="{StaticResource TextMuted}" FontSize="11" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <Button Content="Abrir biblioteca" Click="OpenProfileFolder" Style="{StaticResource QuietButton}" Margin="0,0,8,0" />
                        <Button Content="Importar perfil" Click="ImportProfile" Style="{StaticResource ActionButton}" />
                    </StackPanel>
                </Grid>
                <Grid Grid.Row="2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="330" />
                        <ColumnDefinition Width="18" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Background="{StaticResource Panel}" CornerRadius="16" Padding="14">
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Top" Text="Biblioteca local" FontSize="15" FontWeight="Bold" Margin="4,3,4,12" />
                            <ListBox ItemsSource="{Binding Profiles}" SelectedItem="{Binding SelectedProfile, Mode=TwoWay}">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel>
                                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{Binding Summary}" Foreground="{StaticResource TextMuted}" FontSize="11" Margin="0,4,0,0" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </DockPanel>
                    </Border>
                    <Border Grid.Column="2" Background="{StaticResource Panel}" CornerRadius="16" Padding="22"
                            IsEnabled="{Binding IsEnabled, Converter={StaticResource InverseBoolConverter}}">
                        <Grid>
                          <Grid Visibility="{Binding HasSelectedProfile, Converter={StaticResource BoolToVisibility}}">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="14" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="14" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <StackPanel>
                                <TextBlock Text="{Binding SelectedProfile.Name}" FontSize="23" FontWeight="Bold" />
                                <TextBlock Text="{Binding SelectedProfile.Summary}" Foreground="{StaticResource TextMuted}" Margin="0,5,0,0" />
                            </StackPanel>
                            <ListBox Grid.Row="2" ItemsSource="{Binding SelectedProfile.Values}">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="4,5">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="170" />
                                                <ColumnDefinition Width="190" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding Section}" Foreground="{StaticResource TextMuted}" FontSize="11" />
                                            <TextBlock Grid.Column="1" Text="{Binding Key}" FontWeight="SemiBold" FontSize="12" />
                                            <TextBlock Grid.Column="2" Text="{Binding Value}" FontFamily="Segoe UI Mono" FontSize="11" TextWrapping="Wrap" />
                                        </Grid>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                            <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right">
                                <Button Content="Exportar copia…" Click="ExportProfile" Style="{StaticResource QuietButton}" />
                            </StackPanel>
                          </Grid>
                          <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="320"
                                    Visibility="{Binding HasSelectedProfile, Converter={StaticResource InverseBoolToVisibility}}">
                            <TextBlock Text="Tu biblioteca está vacía" FontSize="19" FontWeight="Bold" TextAlignment="Center" />
                            <TextBlock Text="Importa archivos .agp o .astroeq para guardarlos y revisarlos desde Nexo." Foreground="{StaticResource TextMuted}" TextAlignment="Center" TextWrapping="Wrap" Margin="0,9,0,0" />
                          </StackPanel>
                        </Grid>
                    </Border>
                </Grid>
            </Grid>

            <Grid x:Name="MacrosPage" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="18" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Grid>
                    <StackPanel>
                        <TextBlock Text="Macros" FontSize="29" FontWeight="Bold" />
                        <TextBlock Text="Graba teclado y ratón; asigna macros a botones del ratón o del mando y a direcciones de los sticks." Margin="0,5,0,0" Foreground="{StaticResource TextMuted}" FontSize="14" />
                    </StackPanel>
                    <CheckBox Content="Activar asignaciones por software" HorizontalAlignment="Right" VerticalAlignment="Center"
                              IsChecked="{Binding MacroManager.IsEnabled, Mode=TwoWay}" Foreground="{StaticResource TextMain}"
                              FontWeight="SemiBold" ToolTip="Nexo debe seguir abierto. Los botones de ratón asignados se consumen; las macros del mando se disparan por XInput y la entrada física original sigue llegando al juego." />
                </Grid>
                <Grid Grid.Row="2" DataContext="{Binding MacroManager}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="290" />
                        <ColumnDefinition Width="18" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Background="{StaticResource Panel}" CornerRadius="16" Padding="14">
                        <DockPanel>
                            <Button DockPanel.Dock="Bottom" Content="Nueva macro" Click="NewMacro" Style="{StaticResource ActionButton}" Margin="0,12,0,0" />
                            <TextBlock DockPanel.Dock="Top" Text="Tus macros" FontSize="15" FontWeight="Bold" Margin="4,3,4,12" />
                            <ListBox ItemsSource="{Binding Macros}" SelectedItem="{Binding SelectedMacro, Mode=TwoWay}">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel>
                                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                                            <TextBlock Text="{Binding Summary}" Foreground="{StaticResource TextMuted}" FontSize="11" Margin="0,4,0,0" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </DockPanel>
                    </Border>
                    <Border Grid.Column="2" Background="{StaticResource Panel}" CornerRadius="16" Padding="22">
                        <Grid>
                          <Grid Visibility="{Binding HasSelectedMacro, Converter={StaticResource BoolToVisibility}}">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="14" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="14" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Grid>
                                <StackPanel>
                                    <TextBlock Text="Nombre" Foreground="{StaticResource TextMuted}" FontSize="11" />
                                    <TextBox Text="{Binding SelectedMacro.Name, UpdateSourceTrigger=PropertyChanged}" FontSize="20" FontWeight="Bold"
                                             Background="Transparent" Foreground="{StaticResource TextMain}" BorderThickness="0" Padding="0,5" />
                                </StackPanel>
                                <Button Content="Guardar" Click="SaveMacro" HorizontalAlignment="Right" VerticalAlignment="Center" Style="{StaticResource ActionButton}" />
                            </Grid>
                            <StackPanel Grid.Row="2" Orientation="Horizontal" VerticalAlignment="Center">
                                <Button Content="Iniciar grabación" Click="StartMacroRecording" Style="{StaticResource QuietButton}" Margin="0,0,8,0" IsEnabled="{Binding IsRecording, Converter={StaticResource InverseBoolConverter}}" />
                                <Button Content="Detener" Click="StopMacroRecording" Style="{StaticResource QuietButton}" Margin="0,0,8,0" IsEnabled="{Binding IsRecording}" />
                                <TextBlock Text="{Binding RecorderStatus}" Foreground="{StaticResource TextMuted}" VerticalAlignment="Center" Margin="14,0,0,0" />
                            </StackPanel>
                            <TextBlock Grid.Row="3" Text="Inicia la grabación, cambia a la aplicación destino y realiza la secuencia. Vuelve a Nexo para detenerla y guardarla."
                                       Foreground="{StaticResource TextMuted}" FontSize="11" TextWrapping="Wrap" Margin="2,0,0,0" />
                            <DockPanel Grid.Row="4" LastChildFill="True">
                              <WrapPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,12,0">
                                  <TextBlock Text="Tecla" Foreground="{StaticResource TextMuted}" VerticalAlignment="Center" Margin="0,0,6,0" />
                                  <ComboBox ItemsSource="{Binding KeyOptions}" SelectedItem="{Binding SelectedKey, Mode=TwoWay}" Width="100" Margin="0,0,6,0" />
                                  <Button Content="Añadir tecla" Click="AddMacroKeyAction" Style="{StaticResource QuietButton}" />
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                  <ComboBox ItemsSource="{Binding SystemCommands}" SelectedItem="{Binding SelectedSystemCommandOption, Mode=TwoWay}"
                                            DisplayMemberPath="Label" Width="190" Margin="0,0,6,0" />
                                  <Button Content="Añadir sistema" Click="AddMacroSystemAction" Style="{StaticResource QuietButton}" />
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,0"
                                            Visibility="{Binding SelectedMacro.IsSequence, Converter={StaticResource BoolToVisibility}}">
                                  <TextBlock Text="Fase" Foreground="{StaticResource TextMuted}" VerticalAlignment="Center" Margin="0,0,6,0" />
                                  <ComboBox ItemsSource="{Binding SequenceSections}" SelectedItem="{Binding SelectedSequenceSectionOption, Mode=TwoWay}"
                                            DisplayMemberPath="Label" Width="150" ToolTip="Edita las acciones de pulsar, mantener o soltar." />
                                </StackPanel>
                              </WrapPanel>
                              <ListBox ItemsSource="{Binding SelectedMacroSteps}">
                                <ListBox.ItemTemplate>
                                  <DataTemplate>
                                    <Grid Margin="4,5">
                                      <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="42" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="76" />
                                        <ColumnDefinition Width="38" />
                                        <ColumnDefinition Width="38" />
                                        <ColumnDefinition Width="68" />
                                      </Grid.ColumnDefinitions>
                                      <TextBlock Text="{Binding Index}" Foreground="{StaticResource TextMuted}" FontFamily="Segoe UI Mono" />
                                      <TextBlock Grid.Column="1" Text="{Binding Description}" FontWeight="SemiBold" />
                                      <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right">
                                        <TextBox Text="{Binding DelayMs, UpdateSourceTrigger=PropertyChanged}" Width="48" Padding="4,2"
                                                 HorizontalContentAlignment="Right" ToolTip="Pausa antes de esta acción, en milisegundos." />
                                        <TextBlock Text="ms" Foreground="{StaticResource TextMuted}" VerticalAlignment="Center" Margin="4,0,0,0" />
                                      </StackPanel>
                                      <Button Grid.Column="3" Content="↑" Tag="{Binding}" Click="MoveMacroStepUp" Style="{StaticResource QuietButton}"
                                              FontSize="12" Padding="5,3" ToolTip="Mover arriba" />
                                      <Button Grid.Column="4" Content="↓" Tag="{Binding}" Click="MoveMacroStepDown" Style="{StaticResource QuietButton}"
                                              FontSize="12" Padding="5,3" ToolTip="Mover abajo" />
                                      <Button Grid.Column="5" Content="Eliminar" Tag="{Binding}" Click="DeleteMacroStep" Style="{StaticResource QuietButton}"
                                              FontSize="11" Padding="6,3" />
                                    </Grid>
                                  </DataTemplate>
                                </ListBox.ItemTemplate>
                              </ListBox>
                            </DockPanel>
                          <Grid Grid.Row="6">
                            <Grid.RowDefinitions>
                              <RowDefinition Height="Auto" />
                              <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <TextBlock Text="{Binding AssignmentStatus}" HorizontalAlignment="Right" Foreground="{StaticResource Calibration}"
                                       TextWrapping="Wrap" MaxWidth="560" TextAlignment="Right" Margin="0,0,0,8" />
                            <WrapPanel Grid.Row="1" Orientation="Horizontal">
                              <StackPanel Width="210" Margin="0,0,12,0">
                                <TextBlock Text="Botón asignado" Foreground="{StaticResource TextMuted}" FontSize="11" />
                                <ComboBox ItemsSource="{Binding Bindings}" SelectedItem="{Binding SelectedMacro.BindingOption, Mode=TwoWay}"
                                          DisplayMemberPath="Label" Margin="0,6,0,0" />
                              </StackPanel>
                              <StackPanel Width="210" Margin="0,0,12,0">
                                <TextBlock Text="Botón en la capa G-Shift" Foreground="{StaticResource TextMuted}" FontSize="11" />
                                <ComboBox ItemsSource="{Binding Bindings}" SelectedItem="{Binding SelectedMacro.ShiftBindingOption, Mode=TwoWay}"
                                          DisplayMemberPath="Label" Margin="0,6,0,0" />
                              </StackPanel>
                              <StackPanel Width="230" Margin="0,0,12,0">
                                <TextBlock Text="Perfil de aplicación (.exe; vacío = global)" Foreground="{StaticResource TextMuted}" FontSize="11" />
                                <DockPanel Margin="0,6,0,0">
                                  <Button DockPanel.Dock="Right" Content="Elegir .exe" Click="LinkMacroToApplication" Style="{StaticResource QuietButton}"
                                          Padding="8,5" Margin="6,0,0,0" />
                                  <TextBox Text="{Binding SelectedMacro.ApplicationExecutable, UpdateSourceTrigger=PropertyChanged}"
                                           VerticalContentAlignment="Center" ToolTip="Ruta completa del .exe para esta asignación; vacío usa la macro en cualquier aplicación." />
                                </DockPanel>
                              </StackPanel>
                              <StackPanel Width="210">
                                <TextBlock Text="Mantener G-Shift al sostener" Foreground="{StaticResource TextMuted}" FontSize="11" />
                                <ComboBox ItemsSource="{Binding Bindings}" SelectedItem="{Binding GShiftTriggerOption, Mode=TwoWay}"
                                          DisplayMemberPath="Label" Margin="0,6,0,0" />
                              </StackPanel>
                              <StackPanel Width="210" Margin="0,0,12,0">
                                <TextBlock Text="Repetición" Foreground="{StaticResource TextMuted}" FontSize="11" />
                                <ComboBox ItemsSource="{Binding RepeatModes}" SelectedItem="{Binding SelectedMacro.RepeatModeOption, Mode=TwoWay}"
                                          DisplayMemberPath="Label" Margin="0,6,0,0" />
                              </StackPanel>
                              <StackPanel Width="210">
                                <TextBlock Text="Intervalo de repetición" Foreground="{StaticResource TextMuted}" FontSize="11" />
                                <DockPanel Margin="0,4,0,0">
                                  <TextBlock DockPanel.Dock="Right" Text="{Binding Value, ElementName=MacroRepeatDelay, StringFormat={}{0} ms}"
                                             Foreground="{StaticResource TextMuted}" VerticalAlignment="Center" Margin="8,0,0,0" />
                                  <Slider x:Name="MacroRepeatDelay" Minimum="1" Maximum="1000" SmallChange="1" TickFrequency="1"
                                          IsSnapToTickEnabled="True" Value="{Binding SelectedMacro.RepeatDelayMs, Mode=TwoWay}" />
                                </DockPanel>
                              </StackPanel>
                            </WrapPanel>
                          </Grid>
                          </Grid>
                          <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="320"
                                    Visibility="{Binding HasSelectedMacro, Converter={StaticResource InverseBoolToVisibility}}">
                            <TextBlock Text="Crea tu primera macro" FontSize="19" FontWeight="Bold" TextAlignment="Center" />
                            <TextBlock Text="Graba teclado y ratón. La macro se guarda en este PC y funciona mientras Nexo esté abierto." Foreground="{StaticResource TextMuted}" TextAlignment="Center" TextWrapping="Wrap" Margin="0,9,0,0" />
                          </StackPanel>
                        </Grid>
                    </Border>
                </Grid>
            </Grid>
        </Grid>
    </Grid>
</Window>

